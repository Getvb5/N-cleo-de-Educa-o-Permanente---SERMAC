rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir leitura e escrita para coleções operacionais da rede SERMAC EDUCA
    // permitindo persistência oficial em nuvem com sincronização em tempo real
    match /health_units/{unitId} {
      allow read, write: if true;
    }
    match /training_actions/{actionId} {
      allow read, write: if true;
    }
    match /attendance_records/{attendanceId} {
      allow read, write: if true;
    }
    match /lnt_needs/{lntId} {
      allow read, write: if true;
    }
    match /unit_census/{censusId} {
      allow read, write: if true;
    }
    match /paeps_plans/{planId} {
      allow read, write: if true;
    }
    match /system_metadata/{metaId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
